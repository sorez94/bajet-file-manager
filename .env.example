# --- Database (Turso / libSQL) ---------------------------------------------
# Local development: leave TURSO_DATABASE_URL unset (or use a file: URL) to
# use a local SQLite file with zero external setup. No TURSO_AUTH_TOKEN is
# needed for file: URLs.
#   TURSO_DATABASE_URL=file:./local.db
#
# Production (Turso cloud): set both of these to the values from
# `turso db show <db-name>` / `turso db tokens create <db-name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Initial super admin (used only by `npm run setup`) --------------------
# Only used once, to create the first SUPER_ADMIN if none exists yet.
# Not read at normal application runtime — safe to remove after setup.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-this-password

# --- File storage ------------------------------------------------------------
# STORAGE_DRIVER picks the backend explicitly: "local" or "vercel-blob".
# Leave unset to auto-detect — the app uses "vercel-blob" automatically
# whenever BLOB_READ_WRITE_TOKEN or BLOB_STORE_ID is present (Vercel sets
# one or the other for you once a Blob store is connected to the project —
# which one depends on how it was connected), and "local" otherwise.
STORAGE_DRIVER=

# Only used by the "local" driver. Default/initial storage directory — this
# only takes effect if no value has been saved yet via the Storage Settings
# page (/dashboard/settings/storage); once a super admin saves a path there,
# the database value takes precedence on every future boot.
#   Local dev (Windows/macOS/Linux):  ./storage/uploads
#   Linux server example:             /var/lib/file-manager/uploads
# Not applicable on Vercel — there is no persistent local disk there; use
# the "vercel-blob" driver instead (see README "Vercel deployment").
FILE_STORAGE_PATH=./storage/uploads

# Only used by the "vercel-blob" driver. Set automatically by Vercel once a
# Blob store is connected to this project (via `vercel blob store add` or
# the dashboard's Storage tab) — you shouldn't need to set this by hand.
# Depending on how the store was connected, Vercel provides either
# BLOB_READ_WRITE_TOKEN or BLOB_STORE_ID (+ a runtime VERCEL_OIDC_TOKEN);
# the app and the @vercel/blob SDK handle either automatically.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Maximum accepted upload size, in megabytes. Note: on Vercel, the platform's
# own request body size limit for serverless functions applies on top of
# this — check your plan's current limit before relying on large values here.
MAX_FILE_SIZE_MB=100
